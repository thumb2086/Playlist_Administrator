{
  "name": "playlist-admin",
  "version": "2.6.92",
  "description": "playlist-admin CLI - thin launcher for the Flutter app engine (pipeline, podcast, spotube) + podcast RAG query",
  "type": "module",
  "bin": {
    "playlist-admin": "./cli/index.js"
  },
  "scripts": {
    "pipeline": "node cli/index.js pipeline",
    "podcast": "node cli/index.js podcast",
    "status": "node cli/index.js status",
    "spotube-download": "node cli/index.js spotube-download",
    "spotube-download-all": "node cli/index.js spotube-download-all",
    "spotube-move": "node cli/index.js spotube-move",
    "spotube-cleanup": "node cli/index.js spotube-cleanup"
  },
  "files": [
    "cli/index.js",
    "rag/*.py",
    "rag/README.md"
  ],
  "keywords": [
    "playlist",
    "spotify",
    "podcast",
    "m3u8",
    "music",
    "ffmpeg",
    "spotube"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "private": false
}
